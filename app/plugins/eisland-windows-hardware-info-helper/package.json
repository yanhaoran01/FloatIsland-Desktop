{
  "name": "@eisland/windows-hardware-info-helper",
  "version": "26.0.2",
  "description": "Windows hardware information query via WMI (System.Management) EXE helper.",
  "author": "JNTMTMTM",
  "license": "GPL-3.0",
  "main": "index.js",
  "types": "index.d.ts",
  "os": [
    "win32"
  ],
  "cpu": [
    "x64",
    "arm64",
    "ia32"
  ],
  "scripts": {
